@page "/media"
@rendermode InteractiveServer

<h1>Calculador de Média</h1>

<input type="number" style="padding: 10px; width: 20%; margin-bottom: 10px;" @bind="nota1" placeholder="Digite a Nota 1" />
<input type="number" style="padding: 10px; width: 20%; margin-bottom: 10px;" @bind="nota2" placeholder="Digite a Nota 2" />


<button @onclick="CalcularMedia" class="btn btn-primary" style="padding: 10px;">Calcular Média</button>

@if (!string.IsNullOrEmpty(media))
{
  <p class="@(aprovado ? "text-success" : "text-danger")">@media</p>
}

@code {

  private double nota1 = 0;
  private double nota2 = 0;
  private string media = string.Empty;
  private bool aprovado = false;

  private void CalcularMedia()
  {
    if (double.TryParse(nota1.ToString(), out double nota1Value) && double.TryParse(nota2.ToString(), out double
nota2Value))
    {
      double mediaFinal = (nota1Value + nota2Value) / 2;
      media = $"Nota final: {mediaFinal} - ";

      if (mediaFinal >= 7)
      {
        media += "Aprovado";
        aprovado = true;
      }
      else
      {
        media += "Reprovado";
        aprovado = false;
      }
    }
    else
    {
      media = "Entrada inválida";
      aprovado = false;
    }
  }
}
